# Finnhub.io — free at https://finnhub.io/register
FINNHUB_KEY=your_finnhub_api_key_here

# FRED — free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=your_fred_api_key_here

# SEC EDGAR requires a User-Agent with your email
SEC_EMAIL=your_email@example.com

# Telegram Bot — for alert notifications
# Create bot: https://t.me/BotFather → /newbot
# Get chat ID: send msg to bot, then curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
