<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scalpassistant.scanner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jacolby/app/.venv/bin/python3</string>
        <string>-m</string>
        <string>scripts.scan_and_alert</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jacolby/app</string>

    <!-- Run every 20 minutes. The script handles market-hours filtering internally. -->
    <key>StartInterval</key>
    <integer>1200</integer>

    <key>StandardOutPath</key>
    <string>/Users/jacolby/app/logs/scanner.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jacolby/app/logs/scanner.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/jacolby/app/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Restart if it crashes -->
    <key>KeepAlive</key>
    <false/>

    <!-- Don't start at boot if machine just woke — wait for next interval -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
